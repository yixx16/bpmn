      <bpmndi:BPMNShape id="BoundaryEvent_ErrorAveria_di" bpmnElement="BoundaryEvent_ErrorAveria">
        <dc:Bounds x="382" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="422" y="447" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Inicio_Sub_di" bpmnElement="Flow_Inicio_Sub">
        <di:waypoint x="188" y="280" />
        <di:waypoint x="240" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sub_Entregar_di" bpmnElement="Flow_Sub_Entregar">
        <di:waypoint x="800" y="280" />
