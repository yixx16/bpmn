      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Entregar_Fin_di" bpmnElement="Flow_Entregar_Fin">
        <di:waypoint x="960" y="280" />
        <di:waypoint x="1012" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Boundary_Liberar_di" bpmnElement="Flow_Boundary_Liberar">
        <di:waypoint x="400" y="458" />
        <di:waypoint x="400" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Liberar_Notificar_di" bpmnElement="Flow_Liberar_Notificar">
        <di:waypoint x="450" y="540" />
        <di:waypoint x="500" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notificar_Fin_di" bpmnElement="Flow_Notificar_Fin">
