{
  "id": "realizarReporteVisitaTecnica",
  "type": "default",
  "schemaVersion": 8,
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.20.0",
  "components": [
    {
      "key": "nombre",
      "label": "Nombre del cliente",
      "type": "textfield",
      "id": "Campo_nombre",
      "disabled": true,
      "layout": {
        "row": "Fila_2",
        "columns": null
      }
    },
    {
      "key": "domicilio",
      "label": "Dirección de la visita",
      "type": "textfield",
      "id": "Campo_domicilio",
      "disabled": true,
      "layout": {
        "row": "Fila_3",
        "columns": null
      }
    },
    {
      "key": "falla",
      "label": "Falla reportada",
      "type": "textarea",
      "id": "Campo_falla",
      "disabled": true,
      "layout": {
        "row": "Fila_4",
        "columns": null
      }
    },
    {
      "key": "tipoSolucion",
      "label": "Tipo de solución",
      "type": "select",
      "id": "Campo_tipoSolucion",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Manual",
          "value": "manual"
        },
        {
          "label": "Especializada",
          "value": "especializada"
        },
        {
          "label": "Sin intervención",
          "value": "sinIntervencion"
        },
        {
          "label": "Sin solución",
          "value": "sinSolucion"
        }
      ],
      "layout": {
        "row": "Fila_5",
        "columns": null
      }
    },
    {
      "key": "cobroExtra",
      "label": "Cobro extra",
      "type": "number",
      "id": "Campo_cobroExtra",
      "decimalDigits": 0,
      "increment": 1,
      "defaultValue": 0,
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "Fila_6",
        "columns": null
      }
    },
    {
      "key": "descripcionSucedido",
      "label": "Describa lo sucedido",
      "type": "textarea",
      "id": "Campo_descripcionSucedido",
      "description": "Resuma los hallazgos que sustentan el diagnóstico.",
      "layout": {
        "row": "Fila_7",
        "columns": null
      }
    }
  ]
}
