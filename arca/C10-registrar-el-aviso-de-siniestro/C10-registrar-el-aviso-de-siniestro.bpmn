<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_C10" targetNamespace="http://arca.ai/procesos/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_C10_AvisoReclamacion" name="AvisoReclamacion" />
  <bpmn:collaboration id="Collaboration_C10">
    <bpmn:participant id="Participant_C10_ARCA" name="ARCA · C10 Registrar el aviso de siniestro" processRef="Process_C10_RegistrarAvisoSiniestro" />
    <bpmn:participant id="Participant_C10_Firma" name="Firma asegurada" />
    <bpmn:messageFlow id="MessageFlow_C10_Aviso" name="Aviso de reclamación" sourceRef="Participant_C10_Firma" targetRef="StartEvent_C10_AvisoRecibido" />
    <bpmn:messageFlow id="MessageFlow_C10_Acuse" name="Acuse de recibo" sourceRef="Task_C10_AcusarRecibo" targetRef="Participant_C10_Firma" />
    <bpmn:messageFlow id="MessageFlow_C10_Preverificacion" name="Preverificación de cobertura" sourceRef="Task_C10_ComunicarPreverificacion" targetRef="Participant_C10_Firma" />
    <bpmn:messageFlow id="MessageFlow_C10_SinCobertura" name="Comunicación de no cobertura" sourceRef="Task_C10_ComunicarSinCobertura" targetRef="Participant_C10_Firma" />
  </bpmn:collaboration>
  <bpmn:process id="Process_C10_RegistrarAvisoSiniestro" name="C10 Registrar el aviso de siniestro" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Proceso core de la cadena CV2 Aviso-a-Pago. Dueño: Jefe de Siniestros. Disparador: reclamación contra el asegurado por un error profesional atribuido al uso de IA (interfaz de entrada: póliza vigente emitida en C4). Resultado: siniestro registrado, expediente abierto y cobertura preverificada (interfaz de salida C11 Ajustar el siniestro). La vigencia se verifica a la fecha del hecho y a la de la reclamación. Medidas: tiempo de respuesta inicial, tiempo de preverificación, % avisos sin cobertura, completitud del expediente.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_C10">
      <bpmn:lane id="Lane_C10_Motor" name="Motor de siniestros">
        <bpmn:flowNodeRef>StartEvent_C10_AvisoRecibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_AcusarRecibo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_VerificarVigencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_C10_Vigente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_RecuperarPoliza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_AbrirExpediente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_ComunicarPreverificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_C10_SiniestroRegistrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_C10_MergeSinCobertura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_RegistrarSinCobertura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_ComunicarSinCobertura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_C10_AvisoSinCobertura</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C10_JefeSiniestros" name="Jefe de Siniestros">
        <bpmn:flowNodeRef>Task_C10_RevisarAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_C10_Concepto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_C10_MergeConcepto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_Preverificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_C10_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_RequiereConcepto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_C10_SinPreverificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C10_InformarEstado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_C10_EstadoInformado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C10_AsesorJuridico" name="Asesor Jurídico">
        <bpmn:flowNodeRef>Task_C10_ConceptoJuridico</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_C10_AvisoRecibido" name="Aviso de reclamación recibido">
      <bpmn:outgoing>Flow_C10_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartEvent_C10_AvisoRecibido" messageRef="Message_C10_AvisoReclamacion" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_C10_AcusarRecibo" name="Enviar el acuse de recibo a la firma" camunda:type="external" camunda:topic="c10-acusar-recibo">
      <bpmn:incoming>Flow_C10_01</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_C10_VerificarVigencia" name="Verificar la vigencia de la póliza a la fecha del hecho" camunda:type="external" camunda:topic="c10-verificar-vigencia">
      <bpmn:incoming>Flow_C10_02</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_C10_Vigente" name="¿Póliza vigente?" default="Flow_C10_NoVigente">
      <bpmn:incoming>Flow_C10_03</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_Vigente</bpmn:outgoing>
      <bpmn:outgoing>Flow_C10_NoVigente</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_C10_RecuperarPoliza" name="Recuperar póliza, límites, exclusiones y expediente" camunda:type="external" camunda:topic="c10-recuperar-poliza">
      <bpmn:incoming>Flow_C10_Vigente</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_C10_RevisarAviso" name="Revisar el aviso frente a límites y exclusiones" camunda:candidateGroups="jefes-siniestros" camunda:formKey="camunda-forms:deployment:C10-revisar-aviso.form">
      <bpmn:incoming>Flow_C10_04</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_C10_Concepto" name="¿Requiere concepto jurídico?" default="Flow_C10_SinConcepto">
      <bpmn:incoming>Flow_C10_DMN</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_ConConcepto</bpmn:outgoing>
      <bpmn:outgoing>Flow_C10_SinConcepto</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_C10_ConceptoJuridico" name="Emitir el concepto jurídico sobre la cobertura" camunda:candidateGroups="asesoria-juridica" camunda:formKey="camunda-forms:deployment:C10-concepto-juridico.form">
      <bpmn:incoming>Flow_C10_ConConcepto</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_C10_MergeConcepto">
      <bpmn:incoming>Flow_C10_SinConcepto</bpmn:incoming>
      <bpmn:incoming>Flow_C10_06</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_C10_Preverificar" name="Determinar la preverificación de cobertura" camunda:candidateGroups="jefes-siniestros" camunda:formKey="camunda-forms:deployment:C10-preverificacion.form">
      <bpmn:incoming>Flow_C10_07</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_C10_Resultado" name="¿Resultado?" default="Flow_C10_SinCobertura">
      <bpmn:incoming>Flow_C10_08</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_ConCobertura</bpmn:outgoing>
      <bpmn:outgoing>Flow_C10_SinCobertura</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_C10_AbrirExpediente" name="Abrir el expediente del siniestro" camunda:type="external" camunda:topic="c10-abrir-expediente">
      <bpmn:incoming>Flow_C10_ConCobertura</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Task_C10_ComunicarPreverificacion" name="Comunicar la preverificación y los siguientes pasos" calledElement="Process_C10_ComunicarFirma" camunda:calledElementBinding="latest">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:in sourceExpression="${'PREVERIFICACION'}" target="tipoComunicacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C10_09</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_C10_SiniestroRegistrado" name="Siniestro registrado">
      <bpmn:incoming>Flow_C10_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_C10_MergeSinCobertura">
      <bpmn:incoming>Flow_C10_NoVigente</bpmn:incoming>
      <bpmn:incoming>Flow_C10_SinCobertura</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_C10_RegistrarSinCobertura" name="Registrar el aviso como sin cobertura" camunda:type="external" camunda:topic="c10-registrar-sin-cobertura">
      <bpmn:incoming>Flow_C10_11</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Task_C10_ComunicarSinCobertura" name="Comunicar la ausencia de cobertura y su fundamento" calledElement="Process_C10_ComunicarFirma" camunda:calledElementBinding="latest">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:in sourceExpression="${'SIN_COBERTURA'}" target="tipoComunicacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C10_12</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_C10_AvisoSinCobertura" name="Aviso cerrado sin cobertura">
      <bpmn:incoming>Flow_C10_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C10_01" sourceRef="StartEvent_C10_AvisoRecibido" targetRef="Task_C10_AcusarRecibo" />
    <bpmn:sequenceFlow id="Flow_C10_02" sourceRef="Task_C10_AcusarRecibo" targetRef="Task_C10_VerificarVigencia" />
    <bpmn:sequenceFlow id="Flow_C10_03" sourceRef="Task_C10_VerificarVigencia" targetRef="Gateway_C10_Vigente" />
    <bpmn:sequenceFlow id="Flow_C10_Vigente" name="Sí" sourceRef="Gateway_C10_Vigente" targetRef="Task_C10_RecuperarPoliza">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${polizaVigente}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C10_NoVigente" name="No" sourceRef="Gateway_C10_Vigente" targetRef="Gateway_C10_MergeSinCobertura" />
    <bpmn:sequenceFlow id="Flow_C10_04" sourceRef="Task_C10_RecuperarPoliza" targetRef="Task_C10_RevisarAviso" />
    <bpmn:sequenceFlow id="Flow_C10_05" sourceRef="Task_C10_RevisarAviso" targetRef="Task_C10_RequiereConcepto" />
    <bpmn:sequenceFlow id="Flow_C10_ConConcepto" name="Sí" sourceRef="Gateway_C10_Concepto" targetRef="Task_C10_ConceptoJuridico">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiereConceptoJuridico}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C10_SinConcepto" name="No" sourceRef="Gateway_C10_Concepto" targetRef="Gateway_C10_MergeConcepto" />
    <bpmn:sequenceFlow id="Flow_C10_06" sourceRef="Task_C10_ConceptoJuridico" targetRef="Gateway_C10_MergeConcepto" />
    <bpmn:sequenceFlow id="Flow_C10_07" sourceRef="Gateway_C10_MergeConcepto" targetRef="Task_C10_Preverificar" />
    <bpmn:sequenceFlow id="Flow_C10_08" sourceRef="Task_C10_Preverificar" targetRef="Gateway_C10_Resultado" />
    <bpmn:sequenceFlow id="Flow_C10_ConCobertura" name="Cubierto o con reserva" sourceRef="Gateway_C10_Resultado" targetRef="Task_C10_AbrirExpediente">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultadoPreverificacion != 'SIN_COBERTURA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C10_SinCobertura" name="Sin cobertura" sourceRef="Gateway_C10_Resultado" targetRef="Gateway_C10_MergeSinCobertura" />
    <bpmn:sequenceFlow id="Flow_C10_09" sourceRef="Task_C10_AbrirExpediente" targetRef="Task_C10_ComunicarPreverificacion" />
    <bpmn:sequenceFlow id="Flow_C10_10" sourceRef="Task_C10_ComunicarPreverificacion" targetRef="EndEvent_C10_SiniestroRegistrado" />
    <bpmn:sequenceFlow id="Flow_C10_11" sourceRef="Gateway_C10_MergeSinCobertura" targetRef="Task_C10_RegistrarSinCobertura" />
    <bpmn:sequenceFlow id="Flow_C10_12" sourceRef="Task_C10_RegistrarSinCobertura" targetRef="Task_C10_ComunicarSinCobertura" />
    <bpmn:sequenceFlow id="Flow_C10_13" sourceRef="Task_C10_ComunicarSinCobertura" targetRef="EndEvent_C10_AvisoSinCobertura" />
    <bpmn:businessRuleTask id="Task_C10_RequiereConcepto" name="Determinar si requiere concepto jurídico" camunda:decisionRef="C10_RequiereConceptoJuridico" camunda:resultVariable="requiereConceptoJuridico" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_C10_05</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_DMN</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_C10_DMN" sourceRef="Task_C10_RequiereConcepto" targetRef="Gateway_C10_Concepto" />
    <bpmn:boundaryEvent id="Boundary_C10_SinPreverificar" name="24 h sin preverificar" attachedToRef="Task_C10_Preverificar" cancelActivity="false">
      <bpmn:outgoing>Flow_C10_Timer24h</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_C10_24h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_C10_InformarEstado" name="Informar a la firma el estado del aviso" camunda:type="external" camunda:topic="c10-informar-estado">
      <bpmn:incoming>Flow_C10_Timer24h</bpmn:incoming>
      <bpmn:outgoing>Flow_C10_EstadoInformado</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_C10_EstadoInformado" name="Estado informado">
      <bpmn:incoming>Flow_C10_EstadoInformado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C10_Timer24h" sourceRef="Boundary_C10_SinPreverificar" targetRef="Task_C10_InformarEstado" />
    <bpmn:sequenceFlow id="Flow_C10_EstadoInformado" sourceRef="Task_C10_InformarEstado" targetRef="EndEvent_C10_EstadoInformado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_C10">
    <bpmndi:BPMNPlane id="BPMNPlane_C10" bpmnElement="Collaboration_C10">
      <bpmndi:BPMNShape id="Participant_C10_ARCA_di" bpmnElement="Participant_C10_ARCA" isHorizontal="true">
        <dc:Bounds x="150" y="190" width="3100" height="670" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_C10_AsesorJuridico_di" bpmnElement="Lane_C10_AsesorJuridico" isHorizontal="true">
        <dc:Bounds x="180" y="730" width="3070" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_C10_JefeSiniestros_di" bpmnElement="Lane_C10_JefeSiniestros" isHorizontal="true">
        <dc:Bounds x="180" y="490" width="3070" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_C10_Motor_di" bpmnElement="Lane_C10_Motor" isHorizontal="true">
        <dc:Bounds x="180" y="190" width="3070" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_C10_AvisoRecibido_di" bpmnElement="StartEvent_C10_AvisoRecibido">
        <dc:Bounds x="242" y="290" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="330" width="70" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_AcusarRecibo_di" bpmnElement="Task_C10_AcusarRecibo">
        <dc:Bounds x="370" y="268" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_VerificarVigencia_di" bpmnElement="Task_C10_VerificarVigencia">
        <dc:Bounds x="530" y="268" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_C10_Vigente_di" bpmnElement="Gateway_C10_Vigente" isMarkerVisible="true">
        <dc:Bounds x="715" y="282" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="763" y="250" width="52" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_RecuperarPoliza_di" bpmnElement="Task_C10_RecuperarPoliza">
        <dc:Bounds x="850" y="268" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_RevisarAviso_di" bpmnElement="Task_C10_RevisarAviso">
        <dc:Bounds x="1010" y="515" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_C10_Concepto_di" bpmnElement="Gateway_C10_Concepto" isMarkerVisible="true">
        <dc:Bounds x="1355" y="530" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1305" y="497" width="150" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_ConceptoJuridico_di" bpmnElement="Task_C10_ConceptoJuridico">
        <dc:Bounds x="1490" y="755" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_C10_MergeConcepto_di" bpmnElement="Gateway_C10_MergeConcepto" isMarkerVisible="true">
        <dc:Bounds x="1675" y="530" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_Preverificar_di" bpmnElement="Task_C10_Preverificar">
        <dc:Bounds x="1810" y="515" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_C10_Resultado_di" bpmnElement="Gateway_C10_Resultado" isMarkerVisible="true">
        <dc:Bounds x="1995" y="530" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1945" y="511" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_AbrirExpediente_di" bpmnElement="Task_C10_AbrirExpediente">
        <dc:Bounds x="2130" y="268" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_ComunicarPreverificacion_di" bpmnElement="Task_C10_ComunicarPreverificacion">
        <dc:Bounds x="2290" y="268" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_C10_SiniestroRegistrado_di" bpmnElement="EndEvent_C10_SiniestroRegistrado">
        <dc:Bounds x="2482" y="290" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2468" y="330" width="64" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_C10_MergeSinCobertura_di" bpmnElement="Gateway_C10_MergeSinCobertura" isMarkerVisible="true">
        <dc:Bounds x="2635" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_RegistrarSinCobertura_di" bpmnElement="Task_C10_RegistrarSinCobertura">
        <dc:Bounds x="2770" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_ComunicarSinCobertura_di" bpmnElement="Task_C10_ComunicarSinCobertura">
        <dc:Bounds x="2930" y="390" width="100" height="80" />
