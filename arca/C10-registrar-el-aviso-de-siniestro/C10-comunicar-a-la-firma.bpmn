        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="125" y="145" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C10_ComunicarFirma_di" bpmnElement="Task_C10_ComunicarFirma">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_C10_ComunicarFirma_di" bpmnElement="EndEvent_C10_ComunicarFirma">
