<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_G3_CriteriosValidacion" name="G3 Criterios de validación" namespace="http://camunda.org/schema/1.0/dmn" exporter="Claude Code" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <decision id="G3_CriteriosValidacion" name="Criterios de validación de la versión" camunda:historyTimeToLive="180">
    <decisionTable id="DecisionTable_G3_CriteriosValidacion" hitPolicy="FIRST">
      <input id="Input_G3_CriteriosValidacion_1" label="Sesgo detectado">
        <inputExpression id="InputExpression_G3_CriteriosValidacion_1" typeRef="boolean"><text>sesgoDetectado</text></inputExpression>
      </input>
      <input id="Input_G3_CriteriosValidacion_2" label="AUC">
        <inputExpression id="InputExpression_G3_CriteriosValidacion_2" typeRef="double"><text>auc</text></inputExpression>
      </input>
      <input id="Input_G3_CriteriosValidacion_3" label="Variación máxima de prima (%)">
        <inputExpression id="InputExpression_G3_CriteriosValidacion_3" typeRef="double"><text>variacionPrimaMax</text></inputExpression>
      </input>
      <output id="Output_G3_CriteriosValidacion_1" label="Validación superada" name="validacionSuperada" typeRef="boolean" />
      <output id="Output_G3_CriteriosValidacion_2" label="Motivo" name="motivoValidacion" typeRef="string" />
      <rule id="Rule_G3_CriteriosValidacion_1">
        <description>Una versión con sesgo no se publica</description>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_1_1"><text>true</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_1_2"><text>-</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_1_3"><text>-</text></inputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_1_1"><text>false</text></outputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_1_2"><text>"Sesgo detectado"</text></outputEntry>
      </rule>
      <rule id="Rule_G3_CriteriosValidacion_2">
        <description>Poder predictivo mínimo</description>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_2_1"><text>-</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_2_2"><text>&lt; 0.70</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_2_3"><text>-</text></inputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_2_1"><text>false</text></outputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_2_2"><text>"Poder predictivo insuficiente (AUC menor a 0,70)"</text></outputEntry>
      </rule>
      <rule id="Rule_G3_CriteriosValidacion_3">
        <description>Impacto máximo en primas</description>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_3_1"><text>-</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_3_2"><text>-</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_3_3"><text>&gt; 15</text></inputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_3_1"><text>false</text></outputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_3_2"><text>"Variación de prima superior al 15 %"</text></outputEntry>
      </rule>
      <rule id="Rule_G3_CriteriosValidacion_4">
        <description>Cumple todos los criterios</description>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_4_1"><text>-</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_4_2"><text>-</text></inputEntry>
        <inputEntry id="InputEntry_G3_CriteriosValidacion_4_3"><text>-</text></inputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_4_1"><text>true</text></outputEntry>
        <outputEntry id="OutputEntry_G3_CriteriosValidacion_4_2"><text>"Cumple los criterios"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_G3_CriteriosValidacion">
      <dmndi:DMNShape id="DMNShape_G3_CriteriosValidacion" dmnElementRef="G3_CriteriosValidacion">
        <dc:Bounds height="80" width="180" x="160" y="100" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
