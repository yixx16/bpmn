<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_G3_SometerCarrier" targetNamespace="http://arca.ai/procesos/bpmn" exporter="Claude Code" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_G3_SometerCarrier" name="G3.1 Someter la versión al carrier" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Proceso invocado por la Call Activity de G3. Envía al carrier la versión propuesta, la nota de cambios y la memoria de cálculo.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_G3_SometerCarrier" name="Envío solicitado">
      <bpmn:outgoing>Flow_G3_SometerCarrier_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_G3_SometerCarrier" name="Enviar la versión y la memoria de cálculo al carrier" camunda:type="external" camunda:topic="g3-enviar-solicitud-carrier">
      <bpmn:incoming>Flow_G3_SometerCarrier_1</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_SometerCarrier_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_G3_SometerCarrier" name="Solicitud enviada">
      <bpmn:incoming>Flow_G3_SometerCarrier_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_G3_SometerCarrier_1" sourceRef="StartEvent_G3_SometerCarrier" targetRef="Task_G3_SometerCarrier" />
    <bpmn:sequenceFlow id="Flow_G3_SometerCarrier_2" sourceRef="Task_G3_SometerCarrier" targetRef="EndEvent_G3_SometerCarrier" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_G3_SometerCarrier">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_G3_SometerCarrier" bpmnElement="Process_G3_SometerCarrier">
      <bpmndi:BPMNShape id="StartEvent_G3_SometerCarrier_di" bpmnElement="StartEvent_G3_SometerCarrier">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="125" y="145" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_SometerCarrier_di" bpmnElement="Task_G3_SometerCarrier">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_G3_SometerCarrier_di" bpmnElement="EndEvent_G3_SometerCarrier">
        <dc:Bounds x="392" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="365" y="145" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_G3_SometerCarrier_1_di" bpmnElement="Flow_G3_SometerCarrier_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G3_SometerCarrier_2_di" bpmnElement="Flow_G3_SometerCarrier_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="392" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
