<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_G3" targetNamespace="http://arca.ai/procesos/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_G3_NecesidadVersion" name="NecesidadNuevaVersion" />
  <bpmn:message id="Message_G3_RespuestaCarrier" name="RespuestaCarrier" />
  <bpmn:message id="Message_G3_VersionPublicada" name="VersionModeloPublicada" />
  <bpmn:collaboration id="Collaboration_G3">
    <bpmn:participant id="Participant_G3_ARCA" name="ARCA · G3 Publicar una versión del modelo de score" processRef="Process_G3_PublicarVersionModelo" />
    <bpmn:participant id="Participant_G3_Carrier" name="Carrier" />
    <bpmn:messageFlow id="MessageFlow_G3_Solicitud" name="Versión y memoria de cálculo" sourceRef="Task_G3_SometerCarrier" targetRef="Participant_G3_Carrier" />
    <bpmn:messageFlow id="MessageFlow_G3_Respuesta" name="Aprobación o rechazo" sourceRef="Participant_G3_Carrier" targetRef="Event_G3_RespuestaCarrier" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G3_PublicarVersionModelo" name="G3 Publicar una versión del modelo de score" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Proceso de gestión. Dueño: Actuario Jefe. Clientes: Jefe de Suscripción y Comité de Modelo. Disparadores: nueva evidencia de siniestralidad (C11, G1), deriva detectada, apertura de vertical o jurisdicción, o fallo o norma relevante (S5); llegan como un único mensaje con el motivo como variable. Resultado: versión de rúbrica y pesos calibrada, validada, aprobada y en producción (interfaces de salida C1, C3 y C7). El carrier aprueba las reglas del modelo antes del despliegue. Medidas: poder predictivo (AUC/Gini), frecuencia de publicación, desviación de loss ratio, tiempo de actualización.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G3">
      <bpmn:lane id="Lane_G3_Actuario" name="Actuario Jefe">
        <bpmn:flowNodeRef>StartEvent_G3_Necesidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G3_MergePropuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_Consolidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_Documentar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_SometerCarrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G3_Carrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_G3_NoAprobada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G3_EsperarCarrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_G3_PlazoCarrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_G3_SinRespuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_G3_RespuestaCarrier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G3_IngenieroDatos" name="Ingeniero de Datos">
        <bpmn:flowNodeRef>Gateway_G3_MergeCalibracion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_Calibrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G3_Validacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_Desplegar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_RegistrarVigencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_G3_Publicada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G3_EvaluarCriterios</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G3_ComiteModelo" name="Comité de Modelo">
        <bpmn:flowNodeRef>Task_G3_AprobarComite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G3_Comite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_G3_Rechazada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_G3_Necesidad" name="Necesidad de una nueva versión">
      <bpmn:outgoing>Flow_G3_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartEvent_G3_Necesidad" messageRef="Message_G3_NecesidadVersion" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_G3_MergePropuesta">
      <bpmn:incoming>Flow_G3_01</bpmn:incoming>
      <bpmn:incoming>Flow_G3_Ajustes</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_G3_Consolidar" name="Consolidar la evidencia y proponer el cambio" camunda:candidateGroups="actuarios" camunda:formKey="camunda-forms:deployment:G3-consolidar-propuesta.form">
      <bpmn:incoming>Flow_G3_02</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_G3_MergeCalibracion">
      <bpmn:incoming>Flow_G3_03</bpmn:incoming>
      <bpmn:incoming>Flow_G3_ValidacionNoSuperada</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_G3_Calibrar" name="Preparar los datos y calibrar la rúbrica y los pesos" camunda:candidateGroups="ingenieria-datos" camunda:formKey="camunda-forms:deployment:G3-calibrar-version.form">
      <bpmn:incoming>Flow_G3_04</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_G3_Validar" name="Validar la versión (backtesting y sesgo)" camunda:type="external" camunda:topic="g3-validar-version">
      <bpmn:incoming>Flow_G3_05</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_G3_Validacion" name="¿Validación superada?" default="Flow_G3_ValidacionNoSuperada">
      <bpmn:incoming>Flow_G3_DMN</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_ValidacionSuperada</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_ValidacionNoSuperada</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_G3_Documentar" name="Documentar memoria de cálculo y nota de cambios" camunda:candidateGroups="actuarios" camunda:formKey="camunda-forms:deployment:G3-documentar-version.form">
      <bpmn:incoming>Flow_G3_ValidacionSuperada</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_G3_AprobarComite" name="Revisar y aprobar la versión" camunda:candidateGroups="comite-modelo" camunda:formKey="camunda-forms:deployment:G3-aprobar-version.form">
      <bpmn:incoming>Flow_G3_07</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_G3_Comite" name="¿Decisión del comité?" default="Flow_G3_Rechazada">
      <bpmn:incoming>Flow_G3_08</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_Aprobada</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_Ajustes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_Rechazada</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_G3_Rechazada" name="Propuesta rechazada">
      <bpmn:incoming>Flow_G3_Rechazada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Task_G3_SometerCarrier" name="Someter la versión a aprobación del carrier" calledElement="Process_G3_SometerCarrier" camunda:calledElementBinding="latest">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G3_Aprobada</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_09</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_G3_Carrier" name="¿Aprobada por el carrier?" default="Flow_G3_CarrierRechaza">
      <bpmn:incoming>Flow_G3_10</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_CarrierAprueba</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_CarrierRechaza</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_G3_NoAprobada" name="Versión no aprobada por el carrier">
      <bpmn:incoming>Flow_G3_CarrierRechaza</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_G3_Desplegar" name="Desplegar la versión aprobada en producción" camunda:type="external" camunda:topic="g3-desplegar-version">
      <bpmn:incoming>Flow_G3_CarrierAprueba</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_G3_RegistrarVigencia" name="Registrar la vigencia y la trazabilidad de la versión" camunda:type="external" camunda:topic="g3-registrar-vigencia">
      <bpmn:incoming>Flow_G3_11</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_G3_Publicada" name="Versión publicada">
      <bpmn:incoming>Flow_G3_12</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_EndEvent_G3_Publicada" messageRef="Message_G3_VersionPublicada" camunda:type="external" camunda:topic="g3-publicar-version" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_G3_01" sourceRef="StartEvent_G3_Necesidad" targetRef="Gateway_G3_MergePropuesta" />
    <bpmn:sequenceFlow id="Flow_G3_02" sourceRef="Gateway_G3_MergePropuesta" targetRef="Task_G3_Consolidar" />
    <bpmn:sequenceFlow id="Flow_G3_03" sourceRef="Task_G3_Consolidar" targetRef="Gateway_G3_MergeCalibracion" />
    <bpmn:sequenceFlow id="Flow_G3_04" sourceRef="Gateway_G3_MergeCalibracion" targetRef="Task_G3_Calibrar" />
    <bpmn:sequenceFlow id="Flow_G3_05" sourceRef="Task_G3_Calibrar" targetRef="Task_G3_Validar" />
    <bpmn:sequenceFlow id="Flow_G3_06" sourceRef="Task_G3_Validar" targetRef="Task_G3_EvaluarCriterios" />
    <bpmn:sequenceFlow id="Flow_G3_ValidacionSuperada" name="Sí" sourceRef="Gateway_G3_Validacion" targetRef="Task_G3_Documentar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validacionSuperada}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_ValidacionNoSuperada" name="No" sourceRef="Gateway_G3_Validacion" targetRef="Gateway_G3_MergeCalibracion" />
    <bpmn:sequenceFlow id="Flow_G3_07" sourceRef="Task_G3_Documentar" targetRef="Task_G3_AprobarComite" />
    <bpmn:sequenceFlow id="Flow_G3_08" sourceRef="Task_G3_AprobarComite" targetRef="Gateway_G3_Comite" />
    <bpmn:sequenceFlow id="Flow_G3_Aprobada" name="Aprobada" sourceRef="Gateway_G3_Comite" targetRef="Task_G3_SometerCarrier">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionComite == 'APROBADA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_Ajustes" name="Requiere ajustes" sourceRef="Gateway_G3_Comite" targetRef="Gateway_G3_MergePropuesta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionComite == 'AJUSTES'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_Rechazada" name="Rechazada" sourceRef="Gateway_G3_Comite" targetRef="EndEvent_G3_Rechazada" />
    <bpmn:sequenceFlow id="Flow_G3_09" sourceRef="Task_G3_SometerCarrier" targetRef="Gateway_G3_EsperarCarrier" />
    <bpmn:sequenceFlow id="Flow_G3_10" sourceRef="Event_G3_RespuestaCarrier" targetRef="Gateway_G3_Carrier" />
    <bpmn:sequenceFlow id="Flow_G3_CarrierAprueba" name="Sí" sourceRef="Gateway_G3_Carrier" targetRef="Task_G3_Desplegar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aprobadaCarrier}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_CarrierRechaza" name="No" sourceRef="Gateway_G3_Carrier" targetRef="EndEvent_G3_NoAprobada" />
    <bpmn:sequenceFlow id="Flow_G3_11" sourceRef="Task_G3_Desplegar" targetRef="Task_G3_RegistrarVigencia" />
    <bpmn:sequenceFlow id="Flow_G3_12" sourceRef="Task_G3_RegistrarVigencia" targetRef="EndEvent_G3_Publicada" />
    <bpmn:businessRuleTask id="Task_G3_EvaluarCriterios" name="Evaluar los criterios de validación" camunda:decisionRef="G3_CriteriosValidacion" camunda:resultVariable="resultadoValidacion" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="validacionSuperada">${resultadoValidacion.validacionSuperada}</camunda:outputParameter>
          <camunda:outputParameter name="motivoValidacion">${resultadoValidacion.motivoValidacion}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G3_06</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_DMN</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_G3_DMN" sourceRef="Task_G3_EvaluarCriterios" targetRef="Gateway_G3_Validacion" />
    <bpmn:eventBasedGateway id="Gateway_G3_EsperarCarrier" name="¿Respuesta del carrier?">
      <bpmn:incoming>Flow_G3_09</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_EsperarPlazo</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_EsperarRespuesta</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_G3_PlazoCarrier" name="15 días sin respuesta">
      <bpmn:incoming>Flow_G3_EsperarPlazo</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_SinRespuesta</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_G3_15d">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_G3_SinRespuesta" name="Sin respuesta del carrier">
      <bpmn:incoming>Flow_G3_SinRespuesta</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_G3_RespuestaCarrier" name="Respuesta del carrier recibida">
      <bpmn:incoming>Flow_G3_EsperarRespuesta</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_G3_Respuesta" messageRef="Message_G3_RespuestaCarrier" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_G3_EsperarPlazo" sourceRef="Gateway_G3_EsperarCarrier" targetRef="Event_G3_PlazoCarrier" />
    <bpmn:sequenceFlow id="Flow_G3_EsperarRespuesta" sourceRef="Gateway_G3_EsperarCarrier" targetRef="Event_G3_RespuestaCarrier" />
    <bpmn:sequenceFlow id="Flow_G3_SinRespuesta" sourceRef="Event_G3_PlazoCarrier" targetRef="EndEvent_G3_SinRespuesta" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G3">
    <bpmndi:BPMNPlane id="BPMNPlane_G3" bpmnElement="Collaboration_G3">
      <bpmndi:BPMNShape id="Participant_G3_ARCA_di" bpmnElement="Participant_G3_ARCA" isHorizontal="true">
        <dc:Bounds x="150" y="190" width="3100" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G3_ComiteModelo_di" bpmnElement="Lane_G3_ComiteModelo" isHorizontal="true">
        <dc:Bounds x="180" y="600" width="3070" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G3_IngenieroDatos_di" bpmnElement="Lane_G3_IngenieroDatos" isHorizontal="true">
        <dc:Bounds x="180" y="410" width="3070" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G3_Actuario_di" bpmnElement="Lane_G3_Actuario" isHorizontal="true">
        <dc:Bounds x="180" y="190" width="3070" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_G3_Necesidad_di" bpmnElement="StartEvent_G3_Necesidad">
        <dc:Bounds x="242" y="237" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="210" y="278" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_G3_MergePropuesta_di" bpmnElement="Gateway_G3_MergePropuesta" isMarkerVisible="true">
        <dc:Bounds x="395" y="230" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_Consolidar_di" bpmnElement="Task_G3_Consolidar">
        <dc:Bounds x="530" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_G3_MergeCalibracion_di" bpmnElement="Gateway_G3_MergeCalibracion" isMarkerVisible="true">
        <dc:Bounds x="715" y="450" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_Calibrar_di" bpmnElement="Task_G3_Calibrar">
        <dc:Bounds x="850" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_Validar_di" bpmnElement="Task_G3_Validar">
        <dc:Bounds x="1010" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_G3_Validacion_di" bpmnElement="Gateway_G3_Validacion" isMarkerVisible="true">
        <dc:Bounds x="1355" y="450" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1418" y="479" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_Documentar_di" bpmnElement="Task_G3_Documentar">
        <dc:Bounds x="1490" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_AprobarComite_di" bpmnElement="Task_G3_AprobarComite">
        <dc:Bounds x="1650" y="625" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_G3_Comite_di" bpmnElement="Gateway_G3_Comite" isMarkerVisible="true">
        <dc:Bounds x="1835" y="640" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1883" y="607" width="70" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_G3_Rechazada_di" bpmnElement="EndEvent_G3_Rechazada">
        <dc:Bounds x="2002" y="647" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1991" y="688" width="58" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_SometerCarrier_di" bpmnElement="Task_G3_SometerCarrier">
        <dc:Bounds x="1970" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_G3_Carrier_di" bpmnElement="Gateway_G3_Carrier" isMarkerVisible="true">
        <dc:Bounds x="2635" y="230" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2610" y="197" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_G3_NoAprobada_di" bpmnElement="EndEvent_G3_NoAprobada">
        <dc:Bounds x="2642" y="347" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2684" y="369" width="94" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_Desplegar_di" bpmnElement="Task_G3_Desplegar">
        <dc:Bounds x="2770" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_RegistrarVigencia_di" bpmnElement="Task_G3_RegistrarVigencia">
        <dc:Bounds x="2930" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_G3_Publicada_di" bpmnElement="EndEvent_G3_Publicada">
        <dc:Bounds x="3122" y="457" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3111" y="498" width="58" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_G3_EvaluarCriterios_di" bpmnElement="Task_G3_EvaluarCriterios">
        <dc:Bounds x="1190" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_G3_EsperarCarrier_di" bpmnElement="Gateway_G3_EsperarCarrier">
