<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_C1" targetNamespace="http://arca.ai/procesos/bpmn" exporter="Claude Code" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_C1_CalcularPreScore" name="C1 Calcular el Pre-Score de la firma" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Proceso invocado por la Call Activity de C3 (Capa 1). Un agente lee la web de la firma y la identifica; con esa identidad, Apify busca a sus abogados en el directorio del colegio de abogados y en Avvo; con esas señales se calcula el Pre-Score de 0 a 100. Si el dominio tuvo un scan completo en los últimos 7 días, la plataforma reutiliza el resultado.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_C1" name="Pre-Score solicitado"><bpmn:outgoing>Flow_C1_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_C1_EscanearWeb" name="Escanear la web de la firma e identificarla" camunda:type="external" camunda:topic="c1-escanear-web"><bpmn:incoming>Flow_C1_1</bpmn:incoming><bpmn:outgoing>Flow_C1_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_C1_BuscarAbogados" name="Buscar a sus abogados en el colegio y Avvo (Apify)" camunda:type="external" camunda:topic="c1-buscar-abogados"><bpmn:incoming>Flow_C1_2</bpmn:incoming><bpmn:outgoing>Flow_C1_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_C1_CalcularPreScore" name="Calcular el Pre-Score y sus señales" camunda:type="external" camunda:topic="c1-calcular-prescore"><bpmn:incoming>Flow_C1_3</bpmn:incoming><bpmn:outgoing>Flow_C1_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_C1" name="Pre-Score calculado"><bpmn:incoming>Flow_C1_4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1_1" sourceRef="StartEvent_C1" targetRef="Task_C1_EscanearWeb" />
    <bpmn:sequenceFlow id="Flow_C1_2" sourceRef="Task_C1_EscanearWeb" targetRef="Task_C1_BuscarAbogados" />
    <bpmn:sequenceFlow id="Flow_C1_3" sourceRef="Task_C1_BuscarAbogados" targetRef="Task_C1_CalcularPreScore" />
    <bpmn:sequenceFlow id="Flow_C1_4" sourceRef="Task_C1_CalcularPreScore" targetRef="EndEvent_C1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_C1">
    <bpmndi:BPMNPlane id="BPMNPlane_C1" bpmnElement="Process_C1_CalcularPreScore">
      <bpmndi:BPMNShape id="StartEvent_C1_di" bpmnElement="StartEvent_C1"><dc:Bounds x="152" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="128" y="145" width="84" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C1_EscanearWeb_di" bpmnElement="Task_C1_EscanearWeb"><dc:Bounds x="240" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C1_BuscarAbogados_di" bpmnElement="Task_C1_BuscarAbogados"><dc:Bounds x="400" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C1_CalcularPreScore_di" bpmnElement="Task_C1_CalcularPreScore"><dc:Bounds x="560" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_C1_di" bpmnElement="EndEvent_C1"><dc:Bounds x="712" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="688" y="145" width="84" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_C1_1_di" bpmnElement="Flow_C1_1"><di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C1_2_di" bpmnElement="Flow_C1_2"><di:waypoint x="340" y="120" /><di:waypoint x="400" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C1_3_di" bpmnElement="Flow_C1_3"><di:waypoint x="500" y="120" /><di:waypoint x="560" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C1_4_di" bpmnElement="Flow_C1_4"><di:waypoint x="660" y="120" /><di:waypoint x="712" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
